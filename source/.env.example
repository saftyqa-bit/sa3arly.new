SERVICE_MODE=all
PORT=8080

# Local PostgreSQL
DATABASE_URL=postgresql://sa3arly:sa3arly@postgres:5432/sa3arly
DB_POOL_MIN=1
DB_POOL_MAX=10

# Twice-daily price refresh in Cairo: 10:00 and 20:00.
SCHEDULER_TIMEZONE=Africa/Cairo
REFRESH_CRON=0 10,20 * * *
REFRESH_INTERVAL_MINUTES=720
TASK_STAGGER_SECONDS=2700
FRESHNESS_MINUTES=855
STALE_AFTER_MINUTES=1710
MAX_MAPPINGS_PER_TASK=50
MAX_URL_GROUPS_PER_RUN=50000
INLINE_MAX_URL_GROUPS=25
STALE_TASK_AFTER_MINUTES=180

# Catalog discovery runs separately at 02:30 Cairo. Thirty-five stores per
# night covers all 209 active stores in six nights, then rescans weekly.
CATALOG_DISCOVERY_CRON=30 2 * * *
CATALOG_DISCOVERY_STORES_PER_RUN=35
CATALOG_DISCOVERY_RESCAN_HOURS=168
CATALOG_DISCOVERY_MAX_CANDIDATES_PER_STORE=2000
CATALOG_DISCOVERY_MAX_SITEMAPS_PER_STORE=8
CATALOG_DISCOVERY_MAX_SOURCE_FETCHES=12
CATALOG_DISCOVERY_AUTO_MATCH_SCORE=95
CATALOG_DISCOVERY_REVIEW_SCORE=70
CATALOG_DISCOVERY_NEW_PRODUCT_MIN_STORES=2

# PostgreSQL is primary. Firestore settings are used only during cutover/rollback.
PERSISTENCE_BACKEND=postgres
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=
FIRESTORE_CATALOG_CACHE_SECONDS=300
FIRESTORE_PAGE_CACHE_MAX_BYTES=700000
FIRESTORE_COMPARISON_MAX_BYTES=900000

# Cloud Tasks. Use inline locally and cloud in Google Cloud.
TASKS_MODE=inline
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=sa3arly-scrape
CATALOG_TASKS_QUEUE=sa3arly-catalog-discovery
CLOUD_TASKS_MAX_ATTEMPTS=3
TASK_DISPATCH_DEADLINE_SECONDS=900
WORKER_URL=http://worker:8080
TASKS_SERVICE_ACCOUNT_EMAIL=
INTERNAL_TOKEN=change-this-local-token
LOCAL_SCHEDULER_TRIGGER_ATTEMPTS=3

# Scraping safety and behavior
USER_AGENT=Sa3arlyPriceBot/1.0 (+https://example.com/bot)
HTTP_TIMEOUT_SECONDS=25
MAX_RESPONSE_BYTES=6000000
MAX_REDIRECTS=5
RESPECT_ROBOTS_TXT=true
ENABLE_BROWSER_FALLBACK=true
FOLLOW_DISCOVERED_PRODUCT_URLS=true
MAX_DISCOVERED_FETCHES_PER_TASK=10
MIN_DIRECT_MATCH_SCORE=40
MIN_LISTING_MATCH_SCORE=55
DEFAULT_CURRENCY=EGP
DEFAULT_DELIVERY_REGION=Cairo
MIN_PRICE_RATIO_TO_PREVIOUS=0.20
MAX_PRICE_RATIO_TO_PREVIOUS=5.00
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO

# Private admin dashboard (frontend server environment only)
SA3ARLY_API_BASE_URL=http://localhost:8080
SA3ARLY_INTERNAL_TOKEN=change-this-local-token
SA3ARLY_ADMIN_EMAILS=owner@example.com
# Local screenshot/demo only; never enable in production.
SA3ARLY_ADMIN_PREVIEW=0
SA3ARLY_DEV_ADMIN_EMAIL=

